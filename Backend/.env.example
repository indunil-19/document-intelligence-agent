# Copy to .env and fill in.

# --- LLM (any OpenAI-compatible chat-completions gateway) ---
LLM_BASE_URL=
LLM_API_KEY=

# Must be a model your gateway actually serves.
# Run `python -m scripts.list_models` to see the list.
MODEL=gpt-oss-120b
SUBAGENT_MODEL=gpt-oss-120b
MAX_TOKENS=4096
TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Mock REST API the MCP tools call (mounted on this same app).
MOCK_API_BASE_URL=http://127.0.0.1:8000/mock-api
ENABLE_MCP=true

# Rate limiting (token bucket, per caller, identified by the X-User-Id header)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST=0
RATE_LIMIT_IDLE_TTL_SECONDS=900

# Observability (optional) - LangSmith tracing for the LangGraph pipeline.
# Get a key at https://smith.langchain.com - leave LANGSMITH_TRACING=false to skip.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doc-intelligence-api
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Hybrid search (dense embeddings + BM25) - see app/rag/
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HYBRID_CANDIDATE_K=20
HYBRID_ALPHA=0.5
# Leave empty for local dev (fastembed uses its own default cache dir). Docker sets
# this to a mounted volume so the ~130MB model download survives container recreation.
EMBEDDING_CACHE_DIR=

# Retrieval behaviour
MAX_RETRIEVAL_STEPS=10
ANALYTICS_FANOUT_THRESHOLD=10
ANALYTICS_CHUNK_SIZE=5
ANALYTICS_MAX_SUBAGENTS=6
