# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Agents. Both default to claude-opus-5.
MODEL=claude-opus-5
SUBAGENT_MODEL=claude-opus-5
MAX_TOKENS=4096

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Mock REST API the MCP tools call (mounted on this same app).
MOCK_API_BASE_URL=http://127.0.0.1:8000/mock-api
ENABLE_MCP=true

# Retrieval behaviour
MAX_RETRIEVAL_STEPS=6
ANALYTICS_FANOUT_THRESHOLD=10
ANALYTICS_CHUNK_SIZE=5
ANALYTICS_MAX_SUBAGENTS=6
